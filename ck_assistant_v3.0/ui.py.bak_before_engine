        self.raise_()
        self.setFocus()

    def clear_reply_buttons(self):
        while self.replies_container_layout.count():
            item = self.replies_container_layout.takeAt(0)
            if item.layout():
                sub_layout = item.layout()
                while sub_layout.count():
                    sub_item = sub_layout.takeAt(0)
                    if sub_item.widget():
                        sub_item.widget().deleteLater()
                sub_layout.deleteLater()
            elif item.widget():
                item.widget().deleteLater()

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self._drag_pos = event.globalPos() - self.frameGeometry().topLeft()
            self.activateWindow()
            self.raise_()
            event.accept()
    def mouseMoveEvent(self, event):
        if self._drag_pos and event.buttons() & Qt.LeftButton:
            self.move(event.globalPos() - self._drag_pos)
            event.accept()
    def mouseReleaseEvent(self, event):
        self._drag_pos = None
    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()


class LorebookManagerDialog(QDialog):
    """多世界书管理对话框：列出 / 载入 / 新建 / 保存 / 删除 / 应用启用。"""

    def __init__(self, parent=None):
        super().__init__(parent)
        import json as _json
        self._json = _json
        self._current = None
        self.setWindowTitle("📚 多世界书管理")
        self.setModal(True)
        self.resize(520, 560)
        main = QVBoxLayout(self)
        main.setContentsMargins(15, 15, 15, 15)

        # 上部：知识包列表
        main.addWidget(QLabel("现有知识包："))
        self.list_w = QListWidget()
        self.list_w.itemClicked.connect(self.on_select)
        main.addWidget(self.list_w, stretch=1)

        # 中部：JSON 编辑器
        main.addWidget(QLabel("当前知识包内容（JSON 格式）："))
        self.editor = QTextEdit()
        self.editor.setPlaceholderText('{"name": "书名", "description": "简介", "terms": {"词条": "解释"}}')
        main.addWidget(self.editor, stretch=2)

        # 应用启用勾选
        self.apply_check = QCheckBox("✅ 作为当前会话启用（保存后立即生效）")
        main.addWidget(self.apply_check)

        # 按钮行
        btn_row = QHBoxLayout()
        self.btn_refresh = QPushButton("🔄 刷新")
        self.btn_refresh.clicked.connect(self.refresh_list)
        self.btn_new = QPushButton("➕ 新建")
        self.btn_new.clicked.connect(self.new_book)
        self.btn_save = QPushButton("💾 保存")
        self.btn_save.clicked.connect(self.save_book)
        self.btn_del = QPushButton("🗑️ 删除")
        self.btn_del.clicked.connect(self.delete_book)
        self.btn_close = QPushButton("关闭")
        self.btn_close.clicked.connect(self.accept)
        btn_row.addWidget(self.btn_refresh)
        btn_row.addWidget(self.btn_new)
        btn_row.addWidget(self.btn_save)
        btn_row.addWidget(self.btn_del)
        btn_row.addWidget(self.btn_close)
        main.addLayout(btn_row)

        self.refresh_list()

    def refresh_list(self):
        self.list_w.clear()
        try:
            from engine import list_lorebooks
            for bn in list_lorebooks():
                self.list_w.addItem(bn)
        except Exception:
            pass

    def on_select(self, item):
        name = item.text()
        try:
            from engine import load_lorebook
            data = load_lorebook(name)
            self.editor.setPlainText(self._json.dumps(data, ensure_ascii=False, indent=2))
            self._current = name
        except Exception:
            self.editor.setPlainText("")

    def save_book(self):
        try:
            from engine import save_lorebook
            text = self.editor.toPlainText()
            data = self._json.loads(text)
            name = data.get("name") or self._current or "默认"
            data["name"] = name
            if save_lorebook(data):
                self.refresh_list()
                if self.apply_check.isChecked():
                    cfg = load_config()
                    sel = cfg.get("selected_lorebooks", []) or []
                    if name not in sel:
                        sel.append(name)
                    cfg["selected_lorebooks"] = sel
                    save_config(cfg)
                QMessageBox.information(self, "完成", "✅ 已保存知识包")
            else:
                QMessageBox.warning(self, "失败", "保存知识包失败")
        except Exception as e:
            QMessageBox.warning(self, "格式错误", f"JSON 解析失败：{e}")

    def new_book(self):
        text, ok = QInputDialog.getText(self, "新建世界书", "请输入新知识包名称：")
        if ok and text.strip():
            name = text.strip()
            from engine import save_lorebook
            data = {"name": name, "description": "", "terms": {}}
            save_lorebook(data)
            self.refresh_list()
            self.editor.setPlainText(self._json.dumps(data, ensure_ascii=False, indent=2))
            self._current = name

    def delete_book(self):
        item = self.list_w.currentItem()
        if item is None:
            QMessageBox.warning(self, "提示", "请先在列表中选择要删除的知识包")
            return
        name = item.text()
        if name == "默认":
            QMessageBox.warning(self, "提示", "默认知识包不可删除")
            return
        from engine import delete_lorebook
        if delete_lorebook(name):
            cfg = load_config()
            sel = cfg.get("selected_lorebooks", []) or []
            if name in sel:
                sel.remove(name)
            cfg["selected_lorebooks"] = sel
            save_config(cfg)
            self.refresh_list()
            self.editor.clear()
            QMessageBox.information(self, "完成", f"✅ 已删除知识包《{name}》")